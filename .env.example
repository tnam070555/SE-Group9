# Cổng chạy server
PORT=5000

# Kết nối MongoDB thật (Atlas hoặc MongoDB cài trên máy)
MONGO_URI=mongodb://127.0.0.1:27017/dinh-doc-lap

# Đặt true để chạy thử bằng MongoDB trong RAM (mất dữ liệu khi tắt server, bỏ qua MONGO_URI)
USE_MEMORY_DB=false

# Khóa ký JWT: BẮT BUỘC, chuỗi ngẫu nhiên dài. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=DOI_CHUOI_BI_MAT
JWT_EXPIRES_IN=1d

# Tài khoản admin tự tạo khi server khởi động nếu chưa có (mật khẩu tối thiểu 8 ký tự)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DOI_MAT_KHAU

# Địa chỉ gốc để mã QR dẫn tới (điện thoại truy cập được). Bỏ trống thì dùng địa chỉ đang truy cập.
# Ví dụ khi demo trong mạng LAN: http://192.168.1.10:5000 ; khi deploy: https://ten-mien-cua-ban
PUBLIC_BASE_URL=

# Tự nạp 6 công trình mẫu khi database còn trống. Đặt false để tắt.
SEED_SAMPLE_DATA=true

# Dịch tự động (chỉ dùng khi admin gọi POST /api/artifacts/:id/translate)
# mymemory: miễn phí, không cần khóa, có hạn mức mỗi ngày | google: cần GOOGLE_TRANSLATE_API_KEY | none: tắt
TRANSLATE_PROVIDER=mymemory
# Điền email thật để MyMemory nâng hạn mức miễn phí (tùy chọn)
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=
